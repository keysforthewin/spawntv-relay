# Copy to .env and set a long random password:  openssl rand -base64 24
RELAY_PASSWORD=

# Where viewers reach the stream port (goes into every playUrl). Locally the default is http://localhost:8081.
# PUBLIC_STREAM_BASE=https://relay.example.com

# Host binding / ports (docker compose)
# BIND_ADDRESS=127.0.0.1
# CONTROL_HOST_PORT=8080
# STREAM_HOST_PORT=8081

# Behaviour
# MAX_STREAMS=4            # streams relayed at once
# IDLE_SECONDS=300         # stop a stream nobody has fetched for this long
# READY_SECONDS=60         # how long POST /streams waits for the first segments
# KEEP_ENDED_SECONDS=120   # an ended stream stays readable this long
# SEGMENT_SECONDS=2
# LIST_SIZE=8              # segments in the live window
# MAX_HEIGHT=1080
# VIDEO_DELAY_SECONDS=0    # starting picture delay in seconds (-20..20, negative delays the sound); the TV's Relay tab changes it at runtime
# TRANSCODE=auto           # auto (only non-H.264 sources) | always | never
# ALLOW_GENERIC=false      # true lets yt-dlp's generic extractor take any page or raw media URL
# YTDLP_FORMAT=            # override yt-dlp's -f selector
# YTDLP_VERSION=           # pin yt-dlp at build time (empty = newest)
